{
  "name": "laundry-shop-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local scripts/seed.ts",
    "create-shop": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local scripts/create-shop.ts",
    "create-user": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local scripts/create-user.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --disable-warning=ExperimentalWarning scripts/e2e.ts",
    "cypress:open": "cypress open"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "better-auth": "^1.7.22",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.13.0",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cypress": "^16.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
