# Copy to .env.local.

# Required in production: a long random string that signs the owner's login.
# Make one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# The address people open the app at. Required in production.
# BETTER_AUTH_URL=https://laundry.example.com

# Optional: where the data lives. Default is the file ./data/laundry.db
# DATABASE_URL=file:/var/lib/laundry/laundry.db
# Or a hosted libSQL/Turso database:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=...
